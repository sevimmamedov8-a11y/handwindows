{
  "name": "handarbrowser-windows-one-eye",
  "version": "1.0.0",
  "description": "HandARBrowser desktop single-view edition for Windows",
  "main": "src/main.js",
  "author": "HandARBrowser",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:installer": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "electron": "44.4.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.handarbrowser.windows",
    "productName": "HandARBrowser Windows",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "HandARBrowser-Windows-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
